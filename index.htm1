<style>
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:#fbfaf6;color:#292929;font-family:Arial,Helvetica,sans-serif;line-height:1.7}
img{display:block;width:100%;max-width:100%}
a{text-decoration:none;color:inherit}
:root{--bg:#f3eee3;--paper:#fbfaf6;--dark:#111820;--red:#a51f29;--yellow:#e4c84d;--line:#ddd6ca;--muted:#77716a}
.container{width:min(1180px,calc(100% - 32px));margin:auto}
section{padding:88px 0}
h1,h2,h3,.brand{font-family:Georgia,"Times New Roman",serif;color:#171717}
.kicker{font-size:10px;letter-spacing:3px;font-weight:bold;color:var(--muted);text-transform:uppercase;margin-bottom:18px}
.title{font-size:clamp(40px,6vw,72px);line-height:1;letter-spacing:-2px;margin:0 0 28px}
header{position:sticky;top:0;z-index:20;background:rgba(251,250,246,.97);border-bottom:1px solid var(--line)}
.nav{min-height:72px;display:flex;align-items:center;justify-content:space-between;gap:20px}
.brand{font-size:20px;font-weight:bold;white-space:nowrap}
.brand span{border-bottom:4px solid var(--yellow)}
.menu{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:12px}
.menu a{font-size:10px;font-weight:bold}
.hero{background:var(--bg);min-height:calc(100vh - 72px);display:flex;align-items:center}
.hero-grid{display:grid;grid-template-columns:1fr 500px;gap:65px;align-items:center}
.hero h1{font-size:clamp(54px,7vw,92px);line-height:.9;letter-spacing:-5px;margin:0 0 28px}
.hero h1 span{display:block}
.hero h1 .underline{display:inline;border-bottom:8px solid var(--yellow)}
.hero-text{font-size:17px;max-width:650px;margin-bottom:25px}
.tags{display:flex;flex-wrap:wrap;gap:8px}.tag{border:1px solid var(--line);padding:6px 10px;font-size:10px;background:#fff9}
.photo{overflow:hidden;background:#e9e4da}.photo img{width:100%;height:auto;object-fit:contain}
.about{background:var(--paper)}.about-grid,.turkey-grid,.agency-grid,.bm-grid,.eu-grid,.tech-grid{display:grid;grid-template-columns:1fr 1fr;gap:65px;align-items:center}
.about p,.turkey p,.agency p,.bm p,.eu p,.tech p{font-size:15px;margin:0 0 17px}
.list,.pills,.bm-cards,.eu-cards{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-top:25px}
.list div{border-top:1px solid var(--line);padding:11px 0;font-size:12px;font-weight:bold}
.turkey{background:var(--red);color:#fff}.turkey h2,.turkey p,.turkey .kicker{color:#fff}
.pill{border:1px solid rgba(255,255,255,.35);padding:11px;font-size:12px}
.agency{background:var(--paper)}
.numbered div{display:flex;gap:18px;border-top:1px solid var(--line);padding:13px 0;font-size:13px}.numbered b{font-family:Georgia,serif;font-size:21px;min-width:35px}
.bm,.tech{background:var(--dark);color:#d9dfe4}.bm h2,.tech h2{color:#fff}.bm .kicker,.tech .kicker{color:#aeb8c1}.bm p,.tech p{color:#cbd2d8}
.bm-card,.topic{background:#1a232c;border-left:3px solid var(--yellow);padding:12px;font-size:12px}
.eu{background:var(--bg)}.eu-card{background:#fff;border:1px solid var(--line);padding:12px;font-size:12px;font-weight:bold}
.projects{background:var(--paper)}.lead{font-size:18px;max-width:800px}.project-intro{margin-bottom:42px}
.project-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:13px}.project{background:#fff;border:1px solid var(--line);padding:26px;min-height:205px}.project .number{font:40px Georgia,serif;color:#aaa49b;margin-bottom:24px}.project h3{font-size:21px;margin:0 0 9px}.project p{font-size:13px;color:#777}.wide{grid-column:span 2}
.writings{background:#fff}.article{border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:26px 0;display:grid;grid-template-columns:150px 1fr 120px;gap:22px;align-items:center}.article-date{font-size:10px;font-weight:bold;color:#777}.article h3{font-size:24px;margin:0 0 5px}.article p{font-size:13px;color:#777;margin:0}.read{border:1px solid #aaa;padding:9px;font-size:10px;font-weight:bold;text-align:center}
.gallery{background:var(--bg)}.gallery-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.gallery-card{background:#fff;border:1px solid var(--line);overflow:hidden;margin:0}.gallery-card img{aspect-ratio:4/3;object-fit:cover}.gallery-card figcaption{padding:11px;font-size:11px;font-weight:bold}
.contact{background:var(--dark);color:#fff;text-align:center}.contact h2{color:#fff}.contact .kicker{color:#aeb8c1}.contact p{max-width:700px;margin:0 auto 28px;color:#cbd2d8}.contact-link{display:inline-block;border:1px solid #555;padding:11px 18px;font-size:12px;color:#fff}
footer{background:#0b0b0b;color:#aaa;padding:45px 0 22px}.footer-name{font:30px Georgia,serif;color:#fff;margin-bottom:10px}.footer-desc{font-size:12px;max-width:650px}.footer-bottom{border-top:1px solid #292929;margin-top:35px;padding-top:16px;font-size:10px}
@media(max-width:900px){.nav{align-items:flex-start;padding:12px 0}.brand{font-size:17px}.menu{max-width:260px}.menu a{font-size:8.5px}.hero{min-height:auto}.hero-grid,.about-grid,.turkey-grid,.agency-grid,.bm-grid,.eu-grid,.tech-grid{grid-template-columns:1fr;gap:38px}.hero-copy{padding-top:45px}.hero-image{max-width:600px;margin:auto}.project-grid{grid-template-columns:1fr 1fr}.wide{grid-column:span 2}.gallery-grid{grid-template-columns:1fr 1fr}.article{grid-template-columns:1fr;gap:7px}.read{width:max-content}}
@media(max-width:560px){section{padding:68px 0}.hero h1{font-size:49px}.title{font-size:42px}.list,.pills,.bm-cards,.eu-cards,.project-grid,.gallery-grid{grid-template-columns:1fr}.wide{grid-column:span 1}.hero-image img{width:100%;height:auto}.gallery-card img{aspect-ratio:4/3}}
</style>
</head>
<body>

<header><div class="container nav">
<a class="brand" href="#anasayfa">Muhammet Aren <span>Rahimi</span></a>
<nav class="menu">
<a href="#hakkimda">Hakkımda</a><a href="#turkiye">Türkiye</a><a href="#ajans">Ulusal Ajans</a><a href="#bm">BM</a><a href="#ab">AB</a><a href="#teknoloji">Teknoloji</a><a href="#projeler">Projeler</a><a href="#yazilar">Yazılar</a>
