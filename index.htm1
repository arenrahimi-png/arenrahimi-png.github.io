<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Muhammet Aren Rahimi | Hukuk | BM & AB Proje Koordinatörü</title>

<meta name="description" content="Muhammet Aren Rahimi — Hukuk, Birleşmiş Milletler, Avrupa Birliği, gençlik, politika, iklim, göç, teknoloji ve yapay zekâ alanlarında çalışan proje koordinatörü.">

<style>

*{
    box-sizing:border-box;
    margin:0;
    padding:0;
}

html{
    scroll-behavior:smooth;
}

body{
    font-family:Arial, Helvetica, sans-serif;
    background:#f5f1e8;
    color:#171717;
    line-height:1.7;
}

a{
    color:inherit;
    text-decoration:none;
}

.container{
    width:90%;
    max-width:1200px;
    margin:auto;
}

/* NAVIGATION */

header{
    position:sticky;
    top:0;
    z-index:100;
    background:rgba(245,241,232,.96);
    border-bottom:1px solid #ddd6c9;
}

nav{
    height:72px;
    display:flex;
    align-items:center;
    justify-content:space-between;
}

.logo{
    font-family:Georgia,serif;
    font-size:21px;
    font-weight:bold;
}

.menu{
    display:flex;
    gap:25px;
    font-size:14px;
}

.menu a:hover{
    border-bottom:2px solid #d7b943;
}

/* HERO */

.hero{
    min-height:calc(100vh - 72px);
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:60px;
    align-items:center;
    padding:70px 0;
}

.label{
    text-transform:uppercase;
    letter-spacing:3px;
    font-size:13px;
    color:#68635b;
    font-weight:bold;
}

.hero h1{
    font-family:Georgia,serif;
    font-size:clamp(52px,8vw,95px);
    line-height:.98;
    font-weight:500;
    letter-spacing:-4px;
    margin:20px 0 30px;
}

.hero p{
    font-size:20px;
    color:#4e4a43;
    max-width:650px;
}

.button{
    display:inline-block;
    margin-top:25px;
    padding:13px 22px;
    background:#171717;
    color:white;
}

.hero-image{
    background:#e6dfd3;
    padding:14px;
    transform:rotate(1deg);
}

.hero-image img{
    width:100%;
    height:650px;
    object-fit:cover;
    object-position:center top;
    display:block;
}

/* SECTIONS */

section{
    padding:100px 0;
    border-top:1px solid #ddd6c9;
}

.section-title{
    display:grid;
    grid-template-columns:.35fr 1fr;
    gap:40px;
    margin-bottom:45px;
}

.number{
    font-family:Georgia,serif;
    color:#68635b;
}

h2{
    font-family:Georgia,serif;
    font-size:clamp(42px,6vw,70px);
    font-weight:500;
    line-height:1.05;
}

.subtitle{
    font-size:21px;
    color:#555049;
    margin-top:15px;
}

/* CARDS */

.grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:24px;
}

.card{
    background:#fffdf8;
    border:1px solid #ddd6c9;
    padding:32px;
}

.card h3{
    font-family:Georgia,serif;
    font-size:28px;
    margin-bottom:15px;
}

.card p{
    color:#625d55;
}

.photo-card{
    background:#fffdf8;
    border:1px solid #ddd6c9;
}

.photo-card img{
    width:100%;
    height:360px;
    object-fit:cover;
    display:block;
}

.photo-text{
    padding:25px;
}

/* TAGS */

.tags{
    display:flex;
    flex-wrap:wrap;
    gap:9px;
    margin-top:25px;
}

.tag{
    border:1px solid #555049;
    padding:7px 12px;
    font-size:13px;
}

/* BM */

.dark{
    background:#171717;
    color:white;
    border-color:#171717;
}

.dark .number{
    color:#aaa49a;
}

.dark .subtitle{
    color:#ccc7bf;
}

.dark .card{
    background:#222;
    border-color:#333;
}

.dark .card p{
    color:#c7c2ba;
}

/* TÜRKİYE */

.red{
    background:#a51d25;
    color:white;
}

.red .number,
.red .subtitle{
    color:#f2dada;
}

.red .card{
    background:#fff;
    color:#171717;
}

/* TIMELINE */

.timeline{
    border-top:1px solid #ddd6c9;
}

.timeline-item{
    display:grid;
    grid-template-columns:190px 1fr;
    gap:30px;
    padding:28px 0;
    border-bottom:1px solid #ddd6c9;
}

.timeline-item strong{
    font-family:Georgia,serif;
    font-size:21px;
}

.timeline-item span{
    color:#625d55;
}

/* WRITING */

.article{
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:30px;
    padding:28px 0;
    border-top:1px solid #ddd6c9;
}

.article-date{
    font-size:13px;
    color:#777067;
}

.article h3{
    font-family:Georgia,serif;
    font-size:27px;
    margin:5px 0;
}

/* FOOTER */

footer{
    background:#111;
    color:white;
    padding:60px 0;
}

.footer-name{
    font-family:Georgia,serif;
    font-size:38px;
}

footer p{
    color:#aaa;
    margin-top:10px;
}

/* MOBILE */

@media(max-width:800px){

    .menu{
        display:none;
    }

    .hero{
        grid-template-columns:1fr;
        padding:45px 0;
        gap:35px;
    }

    .hero-image{
        order:-1;
    }

    .hero-image img{
        height:520px;
    }

    .hero h1{
        font-size:58px;
        letter-spacing:-2px;
    }

    .hero p{
        font-size:18px;
    }

    section{
        padding:75px 0;
    }

    .section-title{
        grid-template-columns:1fr;
        gap:12px;
    }

    .grid{
        grid-template-columns:1fr;
    }

    .timeline-item{
        grid-template-columns:1fr;
        gap:5px;
    }

    .article{
        display:block;
    }

    .article .button{
        margin-top:15px;
    }
}

</style>
</head>

<body>

<header>
<div class="container">
<nav>

