<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Muhammet Aren Rahimi | Hukuk | BM & AB Proje Koordinatörü</title>

<meta name="description" content="Muhammet Aren Rahimi — hukuk, Birleşmiş Milletler ve Avrupa Birliği projeleri, gençlik, politika, iklim, göç, teknoloji ve yapay zekâ alanlarında çalışan proje koordinatörü.">

<style>
*{
box-sizing:border-box;
margin:0;
padding:0;
}

html{
scroll-behavior:smooth;
}

body{
font-family:Arial,Helvetica,sans-serif;
background:#f5f1e8;
color:#171717;
line-height:1.65;
}

a{
color:inherit;
text-decoration:none;
}

img{
display:block;
width:100%;
}

.container{
width:min(1180px,92%);
margin:auto;
}

/* NAVIGATION */

nav{
position:sticky;
top:0;
z-index:100;
background:rgba(245,241,232,.94);
backdrop-filter:blur(12px);
border-bottom:1px solid #ddd6c9;
}

.nav-inner{
min-height:76px;
display:flex;
align-items:center;
justify-content:space-between;
gap:25px;
}

.logo{
font-family:Georgia,"Times New Roman",serif;
font-size:21px;
font-weight:bold;
}

.nav-links{
display:flex;
gap:25px;
font-size:14px;
}

.nav-links a:hover{
text-decoration:underline;
}

/* HERO */

.hero{
min-height:calc(100vh - 76px);
display:grid;
grid-template-columns:1.05fr .95fr;
align-items:center;
gap:70px;
padding:70px 0;
}

.hero-text small{
font-size:13px;
letter-spacing:2px;
text-transform:uppercase;
}

.hero h1{
font-family:Georgia,"Times New Roman",serif;
font-size:clamp(48px,7vw,88px);
font-weight:400;
line-height:.98;
margin:20px 0 28px;
}

.hero h1 span{
display:block;
}

.hero p{
font-size:18px;
max-width:650px;
color:#4b4842;
}

.hero-tags{
display:flex;
flex-wrap:wrap;
gap:9px;
margin-top:28px;
}

.tag{
border:1px solid #cfc6b7;
padding:7px 12px;
font-size:12px;
background:#eee8dc;
}

.hero-photo{
height:680px;
overflow:hidden;
background:#ddd;
}

.hero-photo img{
height:100%;
object-fit:cover;
object-position:center;
}

/* GENERAL */

section{
padding:110px 0;
}

.section-label{
font-size:12px;
letter-spacing:2px;
text-transform:uppercase;
margin-bottom:18px;
}

.section-title{
font-family:Georgia,"Times New Roman",serif;
font-size:clamp(38px,5vw,62px);
font-weight:400;
line-height:1.05;
margin-bottom:35px;
}

.lead{
font-family:Georgia,"Times New Roman",serif;
font-size:25px;
line-height:1.4;
max-width:900px;
}

/* ABOUT */

.about-grid{
display:grid;
grid-template-columns:1fr 1fr;
gap:70px;
align-items:start;
}

.about-photo{
height:650px;
overflow:hidden;
}

.about-photo img{
height:100%;
object-fit:cover;
object-position:center;
}

.about-text p{
margin-bottom:20px;
color:#45413c;
}

.about-text strong{
color:#171717;
}

/* BM */

.dark-section{
background:#171717;
color:#f5f1e8;
}

.dark-section .section-label{
color:#d6cfc2;
}

.dark-section p{
color:#d1cbc0;
}

.bm-grid{
display:grid;
grid-template-columns:1fr 1fr;
gap:70px;
align-items:center;
}

.bm-photo{
height:560px;
overflow:hidden;
}

.bm-photo img{
height:100%;
object-fit:cover;
}

.bm-text p{
margin-bottom:20px;
}

/* TURKEY */

.turkey{
background:#a81717;
color:white;
}

.turkey p{
color:#f6dddd;
}

.turkey-grid{
display:grid;
grid-template-columns:1fr 1fr;
gap:70px;
align-items:center;
}

.turkey-photo{
height:520px;
overflow:hidden;
}

.turkey-photo img{
height:100%;
object-fit:cover;
}

/* AGENCY */

.agency{
background:#e9e3d7;
}

.agency-grid{
display:grid;
grid-template-columns:1fr 1fr;
gap:70px;
align-items:center;
}

.agency-photo{
height:520px;
overflow:hidden;
}

.agency-photo img{
height:100%;
object-fit:cover;
}

/* AB */

.ab-grid{
display:grid;
grid-template-columns:1fr 1fr;
gap:70px;
align-items:center;
}

.ab-photo{
height:500px;
overflow:hidden;
}

.ab-photo img{
height:100%;
object-fit:cover;
}

/* TECHNOLOGY */

.tech{
background:#ded9cf;
}

.tech-grid{
display:grid;
grid-template-columns:1fr 1fr;
gap:70px;
align-items:center;
}

.tech-photo{
height:540px;
overflow:hidden;
}

.tech-photo img{
height:100%;
object-fit:cover;
}

.tech-list{
display:grid;
grid-template-columns:1fr 1fr;
gap:12px;
margin-top:30px;
}

.tech-item{
padding:18px;
border:1px solid #bbb4a8;
background:#e8e3da;
}

/* PROJECTS */

.projects{
display:grid;
grid-template-columns:repeat(2,1fr);
gap:18px;
}

.project{
border-top:1px solid #bbb3a5;
padding:27px 5px 25px;
}

.project h3{
font-family:Georgia,"Times New Roman",serif;
font-size:25px;
font-weight:400;
margin-bottom:10px;
}

.project p{
color:#555049;
font-size:15px;
}

/* WRITINGS */

.writing{
border-top:1px solid #aaa294;
border-bottom:1px solid #aaa294;
padding:30px 0;
}

.writing-date{
font-size:11px;
letter-spacing:2px;
margin-bottom:12px;
}

.writing h3{
font-family:Georgia,"Times New Roman",serif;
font-size:30px;
font-weight:400;
margin-bottom:12px;
}

/* GALLERY */

.gallery{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:15px;
}

.gallery div{
height:330px;
overflow:hidden;
background:#ddd;
}

.gallery img{
height:100%;
object-fit:cover;
transition:.4s;
}

.gallery img:hover{
transform:scale(1.03);
}

/* CONTACT */

.contact{
background:#171717;
color:#f5f1e8;
}

.contact-grid{
display:grid;
grid-template-columns:1fr 1fr;
gap:60px;
}

.contact p{
color:#d0cbc2;
margin-bottom:12px;
}

.contact-mail{
font-family:Georgia,"Times New Roman",serif;
font-size:25px;
margin-top:25px;
}

/* FOOTER */

footer{
background:#171717;
color:#9e988f;
border-top:1px solid #393632;
padding:30px 0;
font-size:12px;
}

/* MOBILE */

@media(max-width:800px){

.nav-inner{
min-height:65px;
}

.nav-links{
display:none;
}

.hero{
grid-template-columns:1fr;
gap:35px;
padding:55px 0;
}

.hero h1{
font-size:54px;
}

.hero p{
font-size:16px;
}

.hero-photo{
height:520px;
}

.about-grid,
.bm-grid,
.turkey-grid,
.agency-grid,
.ab-grid,
.tech-grid,
.contact-grid{
grid-template-columns:1fr;
gap:35px;
}

.about-photo{
height:480px;
}

.bm-photo,
.turkey-photo,
.agency-photo,
.ab-photo,
.tech-photo{
height:420px;
}

section{
padding:75px 0;
}

.projects{
grid-template-columns:1fr;
}

.gallery{
grid-template-columns:1fr 1fr;
}

.gallery div{
height:230px;
}

.tech-list{
grid-template-columns:1fr;
}

}

@media(max-width:480px){

.container{
width:90%;
}

.hero h1{
font-size:47px;
}

.hero-photo{
height:470px;
}

.gallery{
grid-template-columns:1fr;
}

.gallery div{
height:360px;
}

}
</style>
</head>

<body>

<nav>
<div class="container nav-inner">

