<!-- GALLERY -->

<section>

<div class="container">

<div class="section-label">09 — Görsel Arşiv</div>

<h2 class="section-title">Çalışmalardan kareler.</h2>

<div class="gallery">

<div>
<img src="file_0000000092a08210b4c6b75ce2a7b391.png" alt="">
</div>

<div>
<img src="file_00000000960c821198226d89d0b6c1d3.png" alt="">
</div>

<div>
